# Júlio Barreto — configuração para Apache/cPanel (HostGator)
Options -Indexes
DirectoryIndex index.html

# Mantém as rotas internas da aplicação funcionando ao atualizar a página.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>
